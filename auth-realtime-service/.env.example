# Copy this file to .env (same folder). Read by src/config.js at startup.

PORT=5000
# Local MongoDB, or paste a MongoDB Atlas connection string here
MONGO_URI=mongodb://localhost:27017/floodlink

# This service SIGNS tokens with this secret; request-service and insights-service VERIFY with it.
# Must be IDENTICAL in all three backends (at least 32 characters)
JWT_SECRET=floodlink-demo-secret-change-me-0123456789
JWT_EXPIRES_IN=24h

CORS_ORIGIN=http://localhost:5173

# Used only by `npm run seed`, which creates demo requests through request-service
REQUEST_SERVICE_URL=http://localhost:8080
