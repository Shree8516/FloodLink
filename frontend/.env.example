# Copy this file to .env (same folder). Vite only exposes variables that start with VITE_.
# Read in src/app/config.js. Restart `npm run dev` after changing.

VITE_AUTH_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
VITE_REQUEST_API_URL=http://localhost:8080/api/v1
VITE_INSIGHTS_URL=http://localhost:5001

# Optional: hours an OPEN request may wait before it is flagged "stale" (default 6).
# For a live demo, 0.05 (3 minutes) lets the audience see the stale marker.
# VITE_STALE_AFTER_HOURS=6
