# Copy this file to .env (same folder) and adjust if needed.
# Read by request-service at startup through application.properties.

PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/floodlink
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Must be IDENTICAL in all three backends (at least 32 characters)
JWT_SECRET=floodlink-demo-secret-change-me-0123456789

INSIGHTS_SERVICE_URL=http://localhost:5001
REALTIME_SERVICE_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5173
