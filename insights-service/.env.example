# Copy this file to .env (same folder). Read by config.py at startup.

PORT=5001
# SQLite file is created automatically inside the "instance" folder
DATABASE_URL=sqlite:///analysis.db

# Must be IDENTICAL in all three backends. This service only VERIFIES tokens.
JWT_SECRET=floodlink-demo-secret-change-me-0123456789

# /stats and /report read the current requests from here
REQUEST_SERVICE_URL=http://localhost:8080

# The priority of every request is judged by a local LLM served by Ollama (https://ollama.com). No LLM, no score.
OLLAMA_URL=http://localhost:11434
# Leave empty to auto-pick the first installed Qwen model (else the first chat model). Or pin one, as shown by `ollama list`.
OLLAMA_MODEL=
# Give up after this many seconds (request-service waits a little longer: INSIGHTS_READ_TIMEOUT_MS)
OLLAMA_TIMEOUT_SECONDS=45
# How long Ollama keeps the model loaded in memory between requests
OLLAMA_KEEP_ALIVE=30m

# The React app (another port) calls /api/v1/stats from the browser, so it needs CORS permission
CORS_ORIGIN=http://localhost:5173
